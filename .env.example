# Splitwise Pro / RupeeWise Environment Variables (Template)
# Copy this file to .env.local and fill in your actual credentials

# Next.js Public Supabase Credentials
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key (Server-side administrative tasks only)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Next.js App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
